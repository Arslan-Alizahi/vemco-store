# Storefront-only deployment (Vercel, Netlify, anywhere serverless).
#
# Set these in the host's environment variables, not in a file.
#
# What this build is: the customer-facing shop, reading its catalogue from
# src/lib/db/seed.ts instead of a database. Vercel's filesystem is read-only
# and each serverless instance gets its own, so SQLite cannot work there —
# and the catalogue does not change between visitors, so it does not need to.
#
# What it is not: the admin panel, the point of sale, or checkout. Those need
# somewhere to write, so they are refused outright rather than left to fail on
# a missing table. Run the full application on a host with a real disk
# (Railway, Render, Fly.io, a VPS) where SQLite works as intended.

NEXT_PUBLIC_SHOWCASE=true

NEXT_PUBLIC_SITE_NAME=VEMCO
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_CURRENCY_LOCALE=en-PK

NEXT_PUBLIC_LOW_STOCK_THRESHOLD=5

# Deliberately absent: DATABASE_PATH, AUTH_SECRET, ADMIN_PASSWORD_HASH and
# every Stripe key. Nothing in this build reads them, and a secret set on a
# deployment that cannot use it is a secret with nowhere to go but a leak.

# ---- Maintenance mode ----
#
# Takes the shop offline without deleting the deployment: every URL answers
# 503 with the "back soon" page, and the link stays the same. Turn it off and
# the site returns exactly as it was.
#
# On Vercel, changing an environment variable needs a redeploy to take effect
# — the Redeploy button on the latest deployment is enough, no push required.
#
# MAINTENANCE_MODE=true
#
# Optional. With this set, visiting /?bypass=<the value> lets your own browser
# through for eight hours, so you can check the shop is ready before reopening
# it to everybody.
#
# MAINTENANCE_BYPASS=some-long-random-string
