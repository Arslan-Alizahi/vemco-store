# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---- Database ----
# Postgres. On Supabase, use the *Transaction pooler* string (port 6543) from
# Project Settings -> Database -> Connection string, not the direct connection:
# serverless scales by running many short-lived instances, and each direct
# connection is a real backend the project has a limited number of.
#
# Apply src/lib/db/schema.sql once, then `npm run db:seed` for the demo
# catalogue. `npm run db:check` says whether it is reachable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Connections per instance. Three covers one page render's fan-out -- its own
# queries plus the layout's navigation and the footer's. Raise it only under
# real load, and remember every instance opens its own.
# DATABASE_POOL_MAX=3

# ---- Uploads ----
# Supabase Storage, bucket "product-images". The Project URL is public and
# appears in every image URL. The service_role key is not: it bypasses every
# storage and row-level policy in the project, so it must stay server-side.
# Giving it a NEXT_PUBLIC_ prefix would compile it into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Where the shop trades ----
# Decides what "today's revenue" means. Timestamps are stored in UTC, and
# without this the day would roll over at 5am Lahore time.
SHOP_TIMEZONE=Asia/Karachi

# ---- Application ----
NEXT_PUBLIC_SITE_NAME=VEMCO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Tax & currency ----
# One currency for the whole shop: the price a customer reads and the amount
# Stripe charges both come from here. They used to disagree — the display said
# PKR while the payment code said 'usd' and multiplied a rupee total by 100,
# so a Rs 185,000 sofa was billed as roughly $185,000.
NEXT_PUBLIC_TAX_RATE=0.18
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_CURRENCY_LOCALE=en-PK

# ---- Features ----
NEXT_PUBLIC_ENABLE_CART_SYNC=true
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=5

# ---- Admin access ----
# Generate both of these with:
#
#   npm run admin:password
#
# There is deliberately no default. Until these are set the admin area is
# closed and says so. A shipped default credential is the kind of thing that
# survives all the way to production, because nothing ever forces anyone to
# change it. The password itself is never stored — only an scrypt hash.
#
# Changing AUTH_SECRET signs everyone out immediately.
AUTH_SECRET=
ADMIN_PASSWORD_HASH=

# ---- Stripe ----
# Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Required. The webhook refuses any event it cannot verify against this, so
# without it no payment is ever recorded. Locally:
#
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# A NOTE ON CURRENCY: your Stripe account has to be able to settle whatever
# NEXT_PUBLIC_CURRENCY is set to. Stripe does not onboard businesses located
# in Pakistan, so if that is where this shop trades, confirm what the account
# can actually accept before going live. The code is coherent either way; the
# account is the thing that decides.

# --- Email -------------------------------------------------------------
# Thank-you messages for counter sales, online orders and bookings.
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it here with no spaces.
# Leave SMTP_USER and SMTP_PASSWORD empty in development -- the shop works
# exactly the same, it just logs "email is disabled" instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
