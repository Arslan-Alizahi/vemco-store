# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---- Database ----
# SQLite file path. Created automatically on first run.
DATABASE_PATH=./data/ecommerce.db

# ---- Uploads ----
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE=5242880

# ---- Application ----
NEXT_PUBLIC_SITE_NAME=ModernStore
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Tax & Currency ----
NEXT_PUBLIC_TAX_RATE=0.18
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# ---- Features ----
NEXT_PUBLIC_ENABLE_CART_SYNC=true
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=5

# ---- Admin ----
# NOTE: admin auth is currently client-side only and this value is not
# actually enforced by the server. See "Known Issues" in the README.
ADMIN_PASSWORD=change-me

# ---- Stripe ----
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Required to verify incoming webhooks (not yet wired up — see Known Issues).
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
